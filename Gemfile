source "https://rubygems.org"

# 1. 기본 Jekyll 및 로컬 서버 구동을 위한 필수 패키지
gem "jekyll", "~> 4.3"
gem "csv"
gem "bigdecimal"
gem "webrick"
gem "liquid", ">= 4.0.4" # 최신 루비 버전과의 호환성을 위해 명시적 추가

# 2. _config.yml에 선언된 플러그인 모음
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-include-cache"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-archives"
  gem "jekyll-paginate"  # 이 줄을 추가합니다!
end